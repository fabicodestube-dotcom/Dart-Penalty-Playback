      m_Calls: []
  m_text: "<b>[FIX] Critical Bugs</b>\n<indent=5%>\u2022 <b>Settings:</b> Fixed a
    shared reference issue where multiple games used the same settings object. Settings
    are now cloned properly.</indent>\n<indent=5%>\u2022 <b>Stats Saving:</b> Fixed
    a bug where global stats were incorrectly locked after saving an unfinished game,
    preventing subsequent updates.</indent>\n\n<b>[UI] Hit Sector</b>\n<indent=5%>\u2022
    Enlarged the prefab slightly and corrected the color assignment.</indent>\n\n<b>[UI]
    Table</b>\n<indent=5%>\u2022 Fixed height calculation. Each row is now exactly
    160 pixels.</indent>\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
