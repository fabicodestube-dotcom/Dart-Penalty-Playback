--- !u!114 &1997792145
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1997792141}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[FEATURE & BALANCE] Gameplay & Settings</b>\n<indent=5%>\u2022 <b>In-Game
    Menu:</b> Replaced full settings access during a game with a quick mute button.</indent>\n<indent=5%>\u2022
    <b>Game Settings:</b> Settings are now cloned at game start and locked during
    playtime.</indent>\n<indent=5%>\u2022 <b>Setup Panel:</b> Redesigned panel to
    support best-of and first-to logic for legs and sets.</indent>\n\n<b>[FEATURE]
    Recorder</b>\n<indent=5%>\u2022 <b>Integration:</b> Fully integrated the recording
    feature.</indent>\n<indent=5%>\u2022 <b>Layout:</b> Adjusted penalty and special
    clips to display four items per row instead of five.</indent>\n\n<b>[UI] History</b>\n<indent=5%>\u2022
    <b>Details:</b> Added penalty settings to history items and restored the missing
    header in GameDetails.</indent>\n<indent=5%>\u2022 <b>Navigation:</b> Removed
    vertical scrollbar and forced swipe menus to auto-reset to page 0 when opened.</indent>\n\n<b>[PERFORMANCE]
    Statistics</b>\n<indent=5%>\u2022 <b>Data Saving:</b> PlayerStats now save directly
    into BasePlayer and auto-update upon saving a game.</indent>\n<indent=5%>\u2022
    <b>Optimization:</b> StatisticsHandler now utilizes pre-calculated stats instead
    of processing all games.</indent>\n\n<b>[UI & DESIGN] Visual Redesign</b>\n<indent=5%>\u2022
    <b>Layout:</b> Enlarged control elements and ad panel, reduced input panel size,
    and downsized player list items.</indent>\n<indent=5%>\u2022 <b>Colors:</b> Brightened
    general colors, backgrounds, and engine input buttons. Darkened the divider prefab.</indent>\n<indent=5%>\u2022
    <b>Typography:</b> Removed bolding from headers, player names, setup mode buttons,
    and popups.</indent>\n<indent=5%>\u2022 <b>Panels:</b> Moved engine settings
    to a left-aligned panel and right-aligned the game abort popup buttons.</indent>\n<indent=5%>\u2022
    <b>Fixes:</b> Restored the missing divider line in the SwipeMenu.</indent>\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
  m_sharedMaterial: {fileID: -7725359125524045537, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
