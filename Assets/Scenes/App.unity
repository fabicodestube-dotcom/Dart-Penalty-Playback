  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[UI] Popups</b>\n<indent=5%>\u2022 <b>InputField:</b> Fixed a graphical
    bug where the input field turned excessively bright when minimizing the popup.</indent>\n\n<b>[UI]
    QuickMenu</b>\n<indent=5%>\u2022 <b>Transition:</b> Improved transitioning animation.</indent>\n\n<b>[UI]
    Polish & Tweaks</b>\n<indent=5%>\u2022 <b>Visual Polish:</b> General UI fine-tuning
    and visual refinements across multiple components.</indent>\n\n<b>[FEATURE] StatisticsHandler</b>\n<indent=5%>\u2022
    <b>Time-based Stats:</b> Introduced time-filtered player statistics (Today, Week,
    Month, Year, All).</indent>\n\n<b>[FIX] StatisticsHandler</b>\n<indent=5%>\u2022
    <b>Recalculation:</b> Statistics are now recalculated on deletion only if GameStats
    had previously been applied.</indent>\n\n<b>[FIX] GameEngines</b>\n<indent=5%>\u2022
    <b>Player Order:</b> Fixed an issue where the player order was calculated incorrectly
    after completing a leg or set.</indent>\n\n<b>[FEATURE] SetupHandler</b>\n<indent=5%>\u2022
    <b>Haptic Feedback:</b> Added vibration feedback while dragging a player.</indent>\n\n<b>[FEATURE]
    Around the Clock</b>\n<indent=5%>\u2022 <b>Streak Effect:</b> Added a new \"Streak\"
    audio clip type and integrated a custom animation into the player item.</indent>\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
