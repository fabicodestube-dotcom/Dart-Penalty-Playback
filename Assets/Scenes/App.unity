  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[PERFORMANCE] App Handler</b>\n<indent=5%>\u2022 <b>Events:</b> Deleting
    games or entire modes is now handled via events, eliminating unnecessary UI rebuilds.</indent>\n\n<b>[PERFORMANCE]
    Logging</b>\n<indent=5%>\u2022 <b>Optimization:</b> Suppressed debug outputs
    in production builds to significantly reduce Android Logcat overhead.</indent>\n\n<b>[UI
    & NAVIGATION] Navigation & UI</b>\n<indent=5%>\u2022 <b>Back Button:</b> Context-dependent
    behavior implemented; Engines and Summary are now treated as popups.</indent>\n<indent=5%>\u2022
    <b>About Page:</b> Re-engineered layout to auto-scale, keeping the top fixed
    while making the bottom scrollable.</indent>\n<indent=5%>\u2022 <b>Bottom Panel:</b>
    Slightly downsized the home icon and replaced the history icon.</indent>\n<indent=5%>\u2022
    <b>Scroll System:</b> GameDetails auto-scrolls to the top when left. Nested Scroll
    Views now pass inputs to parents seamlessly.</indent>\n\n<b>[UI & DESIGN] Themes
    & Architecture</b>\n<indent=5%>\u2022 <b>Themes:</b> CustomClipHandler now renders
    images directly via ThemeColorBinding.</indent>\n<indent=5%>\u2022 <b>Window
    Handler:</b> Cleaned up internal architecture by removing the TargetFrameRate
    override.</indent>\n\n<b>[AUDIO] Sound & Engines</b>\n<indent=5%>\u2022 <b>New
    Audio:</b> Added fresh sound effects for Cricket marks and ATC hits.</indent>\n<indent=5%>\u2022
    <b>Cricket Engine:</b> Score clips only play if no mark was hit. Turn announcements
    now include hits and additional points.</indent>\n<indent=5%>\u2022 <b>ATC Engine:</b>
    Separated score and hit clips at turn-end. Fixed hit count display, including
    the bonus round.</indent>\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
  m_sharedMaterial: {fileID: -7725359125524045537, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
