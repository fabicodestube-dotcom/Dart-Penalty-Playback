  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[UI & DESIGN] Hit Sector</b>\n<indent=5%>\u2022 <b>Prefab:</b> No longer
    generated at runtime; now loaded directly as a prefab.</indent>\n<indent=5%>\u2022
    <b>Visuals:</b> Added grid lines and enlarged the overall size.</indent>\n\n<b>[UI]
    Tables</b>\n<indent=5%>\u2022 <b>Layout:</b> Enlarged all table rows for better
    readability.</indent>\n\n<b>[FEATURE] Bots</b>\n<indent=5%>\u2022 <b>Naming:</b>
    Uniformly renamed all opponents from \"DartBot\" to \"Bot\".</indent>\n<indent=5%>\u2022
    <b>Difficulty:</b> Added colored darts (green, yellow, orange, red) to visualize
    difficulty levels.</indent>\n\n<b>[FEATURE & OPTIMIZATION] Recorder</b>\n<indent=5%>\u2022
    <b>Architecture:</b> Redesigned system to separate FileBrowser and Recorder into
    individual components.</indent>\n<indent=5%>\u2022 <b>UI:</b> The recorder now
    features a pulsating button design.</indent>\n<indent=5%>\u2022 <b>Permissions:</b>
    GameObject is now disabled at start, requesting Android microphone permissions
    only when opened.</indent>\n\n<b>[PERFORMANCE] Window Handler</b>\n<indent=5%>\u2022
    <b>Optimization:</b> Now automatically disables inactive screens that do not
    need to run in the background.</indent>\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
  m_sharedMaterial: {fileID: -7725359125524045537, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
