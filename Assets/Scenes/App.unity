  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[CORE & DATABASE] Database</b>\n<indent=5%>\u2022 <b>IDs:</b> Migrated
    game and player IDs from int to System.Guid to future-proof data handling.</indent>\n\n<b>[UI]
    History & Navigation</b>\n<indent=5%>\u2022 <b>Updates:</b> Saving an existing
    game now correctly updates the entry and moves it to the top of the list.</indent>\n<indent=5%>\u2022
    <b>Scroll System:</b> Optimized ScrollRectEx so child scroll views only forward
    inputs of the opposite scroll direction.</indent>\n\n<b>[FEATURE] Recorder</b>\n<indent=5%>\u2022
    <b>Visuals:</b> Replaced the idle animation with a clean ripple effect.</indent>\n<indent=5%>\u2022
    <b>Trimming:</b> Removed SilenceTrim and introduced a manual trim tool with an
    intensity slider in the UI.</indent>\n\n<b>[UI & GAMEPLAY] Cricket Engine</b>\n<indent=5%>\u2022
    <b>Layout:</b> Widened columns for SideBanner and PlayerPrefabs, and added a
    dedicated layout for two-player mode.</indent>\n\n<b>[GAMEPLAY] ATC Engine</b>\n<indent=5%>\u2022
    <b>Undo Fix:</b> Undo no longer triggers target redistribution, fixing target
    order issues in \"Random\" mode.</indent>\n<indent=5%>\u2022 <b>Adjustments:</b>
    Removed T25 and added a new fire icon as a streak indicator.</indent>\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
  m_sharedMaterial: {fileID: -7725359125524045537, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
