  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>[FEATURE] General</b>\n<indent=5%>\u2022 <b>Localization:</b> Translated
    the majority of the application into English.</indent>\n<indent=5%>\u2022 <b>UI
    Display:</b> Added display info properties to various enums instead of relying
    on default ToString() outputs.</indent>\n\n<b>[UI] Recorder</b>\n<indent=5%>\u2022
    <b>Animation:</b> Fixed an issue with the ripple effect animation.</indent>\n<indent=5%>\u2022
    <b>Usability:</b> Enlarged the hit area of the slider handles for much easier
    dragging.</indent>\n\n<b>[GAMEPLAY] Game Engines</b>\n<indent=5%>\u2022 <b>Bot
    Integration:</b> Added full bot support for Undo, Play, and Pause functionality.</indent>\n\n<b>[GAMEPLAY]
    X01 Game Engine</b>\n<indent=5%>\u2022 <b>Undo Fix:</b> Fixed a bug where undoing
    an untouched game (first set, first leg, no throws) incorrectly removed the initial
    empty turn.</indent>\n\n<b>[GAMEPLAY] ATC Game Engine</b>\n<indent=5%>\u2022
    <b>Targets:</b> Limited targets strictly to \"Single\", \"Double\", and \"Triple\";
    all other redundant modes were removed.</indent>\n\n<b>[UI & DESIGN] Navigation
    & Menus</b>\n<indent=5%>\u2022 <b>About Page:</b> Patch notes are now fully expandable
    with a smooth accordion animation.</indent>\n<indent=5%>\u2022 <b>Setup Panel:</b>
    Integrated the new expand animation and overhauled the general layout.</indent>\n<indent=5%>\u2022
    <b>Options Panel:</b> Redesigned to scale from top-right to bottom-left using
    an optimized pivot setting.</indent>\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
  m_sharedMaterial: {fileID: -7725359125524045537, guid: be9b55762f7f7ee1da240c90f28b5829, type: 2}
