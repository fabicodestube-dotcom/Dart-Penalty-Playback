    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "\xD6zel ses"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "\xD6zel sesler kullan\u0131c\u0131 taraf\u0131ndan kaydedilen seslerdir,
      aksi takdirde varsay\u0131lan paket kullan\u0131l\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Camg\xF6be\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "T\xFCm oyunlar\u0131 sil"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "T\xFCm kaydedilen oyunlar\u0131 silmek istedi\u011Finizden emin
      misiniz? Bu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "Around the Clock oyunlar\u0131n\u0131 sil"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "T\xFCm Around the Clock oyunlar\u0131n\u0131 silmek istedi\u011Finizden
