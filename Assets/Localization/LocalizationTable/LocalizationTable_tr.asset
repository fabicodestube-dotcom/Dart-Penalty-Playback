  - m_Id: 3
    m_Localized: "7 g\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Oyunu iptal et
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Oyun hen\xFCz bitmedi. Oyunu daha sonra devam ettirmek \xFCzere
      kaydetmek mi istersiniz, yoksa iptal etmek mi istersiniz?"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Hakk\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "Titre\u015Fim aktif"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Giri\u015Fler yap\u0131l\u0131rken dokunsal geri bildirimin ger\xE7ekle\u015Fip
      ger\xE7ekle\u015Fmeyece\u011Fini belirler"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Bot ekle
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Hepsi
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: Artan
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: Mavi
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: Bronz
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: Bust
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "\u0130ptal"
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Tavan
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "0-ok yerine buton t\u0131klamas\u0131yla girilebilen tavan vuru\u015Fu"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: Klipler
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Onayla
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: Maliyetler
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "\xD6zel klip taray\u0131c\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "\xD6zel klipler"
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "\xD6zel ses"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "\xD6zel sesler kullan\u0131c\u0131 taraf\u0131ndan kaydedilen seslerdir,
      aksi takdirde varsay\u0131lan paket kullan\u0131l\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Camg\xF6be\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "T\xFCm oyunlar\u0131 sil"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "T\xFCm kaydedilen oyunlar\u0131 silmek istedi\u011Finizden emin
      misiniz? Bu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "Around the Clock oyunlar\u0131n\u0131 sil"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "T\xFCm Around the Clock oyunlar\u0131n\u0131 silmek istedi\u011Finizden
      emin misiniz? Bu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: Klibi sil
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "\u015Eu anda g\xF6r\xFCnt\xFClenen klibi silmek istedi\u011Finizden
      emin misiniz? Bu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "Cricket oyunlar\u0131n\u0131 sil"
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "T\xFCm Cricket oyunlar\u0131n\u0131 silmek istedi\u011Finizden
      emin misiniz? Bu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: Oyuncuyu sil
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "{name} isimli oyuncuyu silmek istedi\u011Finizden emin misiniz?
      Bu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "X01 oyunlar\u0131n\u0131 sil"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "T\xFCm X01 oyunlar\u0131n\u0131 silmek istedi\u011Finizden emin
      misiniz? Bu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: Azalan
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: Kaydetme
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: Kolay
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "Oyunculara g\xF6re filtrele"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: Bitti
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Oyun hen\xFCz kaydedilmedi"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "Oyun hen\xFCz kaydedilmedi. \u015Eimdi kaydetmek ister misiniz?"
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: Oyun bitti
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: "Oyunu ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "Alt\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 49
