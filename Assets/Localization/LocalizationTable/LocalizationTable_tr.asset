    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Y\xFCksek skorlar"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "Ge\xE7mi\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: Isabetler
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: Ana sayfa
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: Devam ediyor
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: Aktif olmayan oyuncular
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Yo\u011Funluk"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: Kaybetme
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Kazanan olarak \xE7\u0131kmadan bir oyuna kat\u0131lman\u0131n
      cezas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: "\u015Eansl\u0131 numara"
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Ayn\u0131 rakamlardan olu\u015Fan bir skora (\xF6rn. 111, 222 vb.)
      ula\u015Ft\u0131\u011F\u0131n\u0131zda verilen ceza"
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Hepsini i\u015Faretle"
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "\u0130\u015Faretler"
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "Tur ba\u015F\u0131na i\u015Faretler"
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: Orta
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: Mod
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: Yeni oyuncu
    m_Metadata:
      m_Items: []
  - m_Id: 68
    m_Localized: "\u0130sim \xE7ok k\u0131sa (en az 2 karakter)"
    m_Metadata:
      m_Items: []
  - m_Id: 69
    m_Localized: Borda isabet yok
    m_Metadata:
      m_Items: []
  - m_Id: 70
    m_Localized: "T\xFCm oklar\u0131n duvara veya tavana gelmesi durumunda verilen
      ceza"
    m_Metadata:
      m_Items: []
  - m_Id: 71
    m_Localized: "Kaydedilmi\u015F klip yok"
    m_Metadata:
      m_Items: []
  - m_Id: 72
    m_Localized: Mevcut oyun yok
    m_Metadata:
      m_Items: []
