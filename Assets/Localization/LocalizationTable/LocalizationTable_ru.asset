    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435
      \u0437\u0432\u0443\u043A\u0438 \u2014 \u044D\u0442\u043E \u0437\u0432\u0443\u043A\u0438,
      \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C,
      \u0438\u043D\u0430\u0447\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439 \u043F\u0430\u043A\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "\u0426\u0438\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0432\u0441\u0435 \u0438\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435
      \u0438\u0433\u0440\u044B? \u042D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0438\u0433\u0440\u044B
