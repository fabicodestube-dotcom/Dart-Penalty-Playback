    },
    "m_Name": "RectComet (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -700.0,
            "y": 150.0,
            "width": 220.0,
            "height": 260.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "8aee4dc3e8394bfd946682e090c3a70f"
        },
        {
            "m_Id": "9e6bb2737a1b4e22a742f12a3b9a35ac"
        },
        {
            "m_Id": "edab24eb5a614231b699b8032aedfc7e"
        },
        {
            "m_Id": "6a9f2d7a2d354203b8052576a94cbe9e"
        },
        {
            "m_Id": "9f71e8e89f684734bdf6d90464c9a193"
        },
        {
            "m_Id": "8e09d6a9069d4a7fb95ad72e76e78aec"
        },
        {
            "m_Id": "811b92e441644df59fb02437ad50ae52"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RectComet",
    "m_FunctionSource": "",
    "m_FunctionBody": "float hx = Aspect * 0.5;\r\nfloat hy = 0.5;\r\nfloat2 c = (UV - 0.5) * float2(Aspect, 1.0);\r\nfloat W = Aspect;\r\nfloat H = 1.0;\r\nfloat P = 2.0 * (W + H);\r\nfloat dl = c.x + hx;\r\nfloat dr = hx - c.x;\r\nfloat db = c.y + hy;\r\nfloat dt = hy - c.y;\r\nfloat dm = min(min(dl, dr), min(db, dt));\r\nfloat p;\r\nif (dm == dt) p = (c.x + hx) / P;\r\nelse if (dm == dr) p = (W + (hy - c.y)) / P;\r\nelse if (dm == db) p = (W + H + (hx - c.x)) / P;\r\nelse p = (2.0 * W + H + (c.y + hy)) / P;\r\np = clamp(p, 0.0, 1.0);\r\nfloat d = frac(p - Rotation);\r\nfloat head = smoothstep(0.0, GapSharp, d);\r\nfloat behind = 1.0 - d;\r\nfloat tail = lerp(TailMin, 1.0, smoothstep(0.0, TailLength, behind));\r\nComet = head * tail;"
}

